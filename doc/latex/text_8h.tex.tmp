void \mbox{\hyperlink{text_8h_a3bc9b1e41c158e284028b2808693e898}{create\+\_\+coord\+\_\+vector\+\_\+text}} (const char $\ast$text, \mbox{\hyperlink{structatlas}{atlas}} $\ast$a, \mbox{\hyperlink{structvertex3D}{vertex3D}} \&origin, \mbox{\hyperlink{structvertex2D}{vertex2D}} \&window\+\_\+coord\+\_\+scale, std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&a\+\_\+glyphs\+\_\+box, std\+::vector$<$ \mbox{\hyperlink{structvertex2D}{vertex2D}} $>$ \&a\+\_\+glyphs\+\_\+vertex)
\begin{DoxyCompactList}\small\item\em This method is called in a loop on std\+::vector$<$\+G\+Ldata$>$ my\+\_\+v\+\_\+\+M\+D\+E\+\_\+data within init\+\_\+glyph(). At each iteration a mde\+\_\+member name or data of class std\+::string is processed. During each of these iteration create\+\_\+coord\+\_\+vector\+\_\+text loops through each character of the string from first to last. calculating vertices and texture coordinates respectively pushing back in vectors glyphs\+\_\+vertex and glyphs\+\_\+box. It also pushes back the number of glyphs per text in vector nb\+\_\+glyphs\+\_\+per\+\_\+text. \end{DoxyCompactList}\item 
void \mbox{\hyperlink{text_8h_a6427550fc33633c19a2984ff7be1fd74}{text\+\_\+frame}} (std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&vector\+\_\+input, std\+::vector$<$ uint $>$ \&nb\+\_\+glyphs, \mbox{\hyperlink{structvertex3D}{vertex3D}} \&offset, \mbox{\hyperlink{structvertex2D}{vertex2D}} \&padding)
\begin{DoxyCompactList}\small\item\em This method is to calculate the coordinates of each glyphs to be displayed in vertex\+\_\+3D a vector of \mbox{\hyperlink{structvertex3D}{vertex3D}}. It first gets the min and max values for each text element of the \mbox{\hyperlink{classMDE}{M\+DE}} to be displayed and stores them in 2 vectors bottom\+\_\+left\+\_\+front and top\+\_\+right\+\_\+back. It then uses these two vectors and calls \mbox{\hyperlink{text_8h_a4e1bd82ff5f0e3f821efdc438d638ed8}{create\+\_\+vector()}} to fill-\/in vector\+\_\+input. Next in the process it calls \mbox{\hyperlink{group__group__init_gabde5ff272ceb5c53880ed068a10b265c}{init\+\_\+vectors()}} and then \mbox{\hyperlink{group__group__init_ga11a2aa40ef1cca9e941f47ceec84d95d}{init\+\_\+box()}} to initialise G\+PU buffers for display of the text\textquotesingle{}s backgound 3d box. \end{DoxyCompactList}\item 
void \mbox{\hyperlink{text_8h_a4e1bd82ff5f0e3f821efdc438d638ed8}{create\+\_\+vector}} (std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&vector3D, std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&v\+\_\+origin, std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&vector\+\_\+blf, std\+::vector$<$ \mbox{\hyperlink{structvertex3D}{vertex3D}} $>$ \&vector\+\_\+trb, \mbox{\hyperlink{structvertex2D}{vertex2D}} \&padding)
